rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['title', 'description', 'completed', 'priority', 'userId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 500
        && data.userId == request.auth.uid;
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isVerified() 
        && isValidId(reminderId)
        && isValidReminder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(existing().userId)
        && isVerified()
        && isValidReminder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isOwner(existing().userId);
    }
  }
}
